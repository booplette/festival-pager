[Unit]
Description=Festival Pager — LoRa mesh notification service + web UI
After=network.target
Wants=hostapd.service dnsmasq.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/festival-pager
ExecStart=/home/pi/festival-pager/deploy/run.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Rate-limit restart to avoid thrashing
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target